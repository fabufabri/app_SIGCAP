<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.BuscarOTController"
    prefWidth="1500"
    prefHeight="850"
    style="-fx-background-color:#E4E9EB;">

    <VBox
        spacing="12"
        AnchorPane.topAnchor="10"
        AnchorPane.bottomAnchor="10"
        AnchorPane.leftAnchor="20"
        AnchorPane.rightAnchor="20">

        <HBox
            prefHeight="80"
            alignment="CENTER_LEFT"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="15"
                    right="20"
                    bottom="15"
                    left="20"/>
            </padding>

            <VBox
                spacing="4"
                HBox.hgrow="ALWAYS">

                <Label
                    text="BUSCAR ÓRDENES DE TRABAJO"
                    style="-fx-text-fill:white;-fx-font-size:21px;-fx-font-weight:bold;"/>

                <Label
                    text="Consulta general de las órdenes registradas en SIGCAP"
                    style="-fx-text-fill:#DDEAF6;-fx-font-size:12px;"/>

            </VBox>

            <Label
                text="SIGCAP"
                style="-fx-text-fill:white;-fx-font-size:15px;-fx-font-weight:bold;"/>

        </HBox>

        <VBox
            spacing="10"
            style="-fx-background-color:white;-fx-background-radius:6;">

            <padding>
                <Insets
                    top="15"
                    right="18"
                    bottom="15"
                    left="18"/>
            </padding>

            <Label
                text="CRITERIO DE BÚSQUEDA"
                style="-fx-text-fill:#20487A;-fx-font-size:14px;-fx-font-weight:bold;"/>

            <HBox spacing="15">

                <RadioButton
                    fx:id="rad_codigo"
                    text="OT"
                    selected="true"
                    style="-fx-text-fill:#163D67;"/>

                <RadioButton
                    fx:id="rad_cliente"
                    text="Cliente"
                    style="-fx-text-fill:#163D67;"/>

                <RadioButton
                    fx:id="rad_campania"
                    text="Campaña"
                    style="-fx-text-fill:#163D67;"/>

                <RadioButton
                    fx:id="rad_estado"
                    text="Estado"
                    style="-fx-text-fill:#163D67;"/>

                <RadioButton
                    fx:id="rad_ciudad"
                    text="Ciudad"
                    style="-fx-text-fill:#163D67;"/>

                <RadioButton
                    fx:id="rad_responsable"
                    text="Responsable"
                    style="-fx-text-fill:#163D67;"/>

            </HBox>

            <HBox spacing="10">

                <TextField
                    fx:id="txt_buscar"
                    promptText="Escriba el texto que desea buscar..."
                    prefHeight="38"
                    HBox.hgrow="ALWAYS"/>

                <ComboBox
                    fx:id="cmb_estado"
                    prefWidth="190"
                    prefHeight="38"/>

                <ComboBox
                    fx:id="cmb_ciudad"
                    prefWidth="170"
                    prefHeight="38"/>

                <Button
                    text="Buscar"
                    onAction="#acc_buscar"
                    prefWidth="100"
                    prefHeight="38"
                    style="-fx-background-color:#0878D1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

                <Button
                    text="Limpiar"
                    onAction="#acc_limpiar"
                    prefWidth="90"
                    prefHeight="38"
                    style="-fx-background-color:#E4E9EB;-fx-text-fill:#20487A;-fx-font-weight:bold;-fx-background-radius:4;"/>

            </HBox>

        </VBox>

        <VBox
            spacing="8"
            VBox.vgrow="ALWAYS"
            style="-fx-background-color:white;-fx-background-radius:6;">

            <padding>
                <Insets
                    top="15"
                    right="15"
                    bottom="15"
                    left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <VBox
                    spacing="3"
                    HBox.hgrow="ALWAYS">

                    <Label
                        text="ÓRDENES ENCONTRADAS"
                        style="-fx-text-fill:#20487A;-fx-font-size:16px;-fx-font-weight:bold;"/>

                    <Label
                        text="Doble clic sobre una OT para abrir su detalle."
                        style="-fx-text-fill:#64748B;-fx-font-size:11px;"/>

                </VBox>

                <HBox
                    alignment="CENTER_RIGHT"
                    spacing="6">

                    <Label
                        text="Total:"
                        style="-fx-text-fill:#64748B;-fx-font-size:12px;"/>

                    <Label
                        fx:id="lbl_total"
                        text="0"
                        style="-fx-text-fill:#20487A;-fx-font-size:18px;-fx-font-weight:bold;"/>

                </HBox>

            </HBox>

            <TableView
                fx:id="tb_ordenes"
                VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                        fx:id="col_codigo"
                        text="OT"
                        prefWidth="125"/>

                    <TableColumn
                        fx:id="col_cliente"
                        text="Cliente"
                        prefWidth="180"/>

                    <TableColumn
                        fx:id="col_campania"
                        text="Campaña"
                        prefWidth="190"/>

                    <TableColumn
                        fx:id="col_ciudad"
                        text="Ciudad"
                        prefWidth="110"/>

                    <TableColumn
                        fx:id="col_fecha"
                        text="Fecha"
                        prefWidth="110"/>

                    <TableColumn
                        fx:id="col_fecha_requerida"
                        text="Fecha requerida"
                        prefWidth="125"/>

                    <TableColumn
                        fx:id="col_prioridad"
                        text="Prioridad"
                        prefWidth="100"/>

                    <TableColumn
                        fx:id="col_responsable"
                        text="Responsable"
                        prefWidth="150"/>

                    <TableColumn
                        fx:id="col_estado"
                        text="Estado"
                        prefWidth="150"/>

                </columns>

                <placeholder>

                    <Label
                        text="No se encontraron Órdenes de Trabajo."
                        style="-fx-text-fill:#64748B;-fx-font-size:13px;"/>

                </placeholder>

            </TableView>

        </VBox>

        <HBox
            alignment="CENTER_RIGHT"
            spacing="8">

            <Button
                text="Actualizar"
                onAction="#acc_actualizar"
                prefWidth="105"
                prefHeight="38"
                style="-fx-background-color:#20487A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

            <Button
                text="Volver"
                onAction="#acc_volver"
                prefWidth="100"
                prefHeight="38"
                style="-fx-background-color:#082F52;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>

    </VBox>

</AnchorPane>