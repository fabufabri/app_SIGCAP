<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.CiudadesController"
    prefWidth="900"
    prefHeight="600"
    style="-fx-background-color:#F5F7FA;">

    <top>

        <VBox
            spacing="4"
            style="-fx-background-color:#062B4D;">

            <padding>
                <Insets
                    top="20"
                    right="25"
                    bottom="20"
                    left="25"/>
            </padding>

            <Label
                text="Ciudades"
                style="-fx-font-size:24px;-fx-font-weight:bold;-fx-text-fill:white;"/>

            <Label
                text="Administración de ciudades de operación"
                style="-fx-font-size:13px;-fx-text-fill:#C9D8E6;"/>

        </VBox>

    </top>

    <center>

        <VBox
            spacing="15"
            style="-fx-background-color:#F5F7FA;">

            <padding>
                <Insets
                    top="20"
                    right="25"
                    bottom="20"
                    left="25"/>
            </padding>

            <HBox
                spacing="10"
                alignment="CENTER_LEFT">

                <Label
                    text="Buscar:"
                    style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>

                <TextField
                    fx:id="txt_buscar"
                    prefWidth="350"
                    promptText="Nombre de ciudad..."
                    style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-radius:5;-fx-background-radius:5;"/>

                <Button
                    fx:id="btn_actualizar"
                    text="Actualizar"
                    onAction="#acc_actualizar"
                    prefHeight="35"
                    style="-fx-background-color:#E2E8F0;-fx-text-fill:#334155;-fx-font-weight:bold;-fx-background-radius:5;"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button
                    fx:id="btn_nuevo"
                    text="+ Nueva Ciudad"
                    onAction="#acc_nuevo"
                    prefHeight="35"
                    style="-fx-background-color:#0878D1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:5;"/>

            </HBox>

            <Label
                fx:id="lbl_total"
                text="Registros: 0"
                style="-fx-font-size:12px;-fx-text-fill:#64748B;"/>

            <TableView
                fx:id="tb_ciudades"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:white;-fx-border-color:#CBD5E1;">

                <columns>

                    <TableColumn
                        fx:id="col_id"
                        text="ID"
                        prefWidth="80"/>

                    <TableColumn
                        fx:id="col_nombre"
                        text="Ciudad"
                        prefWidth="500"/>

                    <TableColumn
                        fx:id="col_estado"
                        text="Estado"
                        prefWidth="180"/>

                </columns>

                <placeholder>

                    <Label
                        text="No existen ciudades registradas."
                        style="-fx-text-fill:#64748B;"/>

                </placeholder>

            </TableView>

            <HBox
                alignment="CENTER_RIGHT">

                <Button
                    fx:id="btn_cerrar"
                    text="Cerrar"
                    onAction="#acc_cerrar"
                    prefWidth="100"
                    prefHeight="35"
                    style="-fx-background-color:#E2E8F0;-fx-text-fill:#334155;-fx-font-weight:bold;-fx-background-radius:5;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>