<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.NuevoUsuarioController"
    prefWidth="650"
    prefHeight="570"
    style="-fx-background-color:#E4E9EB;">

    <VBox
        spacing="0"
        AnchorPane.topAnchor="0"
        AnchorPane.bottomAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0">

        <VBox
            prefHeight="85"
            spacing="5"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="15"
                    right="25"
                    bottom="15"
                    left="25"/>
            </padding>

            <Label
                text="USUARIO"
                style="-fx-text-fill:white;-fx-font-size:21px;-fx-font-weight:bold;"/>

            <Label
                text="Registro y mantenimiento de usuarios"
                style="-fx-text-fill:#DDEAF6;-fx-font-size:12px;"/>

        </VBox>

        <VBox
            VBox.vgrow="ALWAYS"
            spacing="15">

            <padding>
                <Insets
                    top="22"
                    right="25"
                    bottom="20"
                    left="25"/>
            </padding>

            <VBox
                spacing="12"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <padding>
                    <Insets
                        top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
                </padding>

                <Label
                    text="DATOS DEL USUARIO"
                    style="-fx-text-fill:#20487A;-fx-font-size:15px;-fx-font-weight:bold;"/>

                <GridPane
                    hgap="12"
                    vgap="12">

                    <TextField
                        fx:id="txt_usuario"
                        promptText="Nombre de usuario"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Usuario:"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <Label
                        text="Contraseña:"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <PasswordField
                        fx:id="txt_clave"
                        promptText="Contraseña"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Confirmar:"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <PasswordField
                        fx:id="txt_confirmar"
                        promptText="Repita la contraseña"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Nombres:"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <TextField
                        fx:id="txt_nombres"
                        promptText="Nombres"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Apellidos:"
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <TextField
                        fx:id="txt_apellidos"
                        promptText="Apellidos"
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Correo:"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <TextField
                        fx:id="txt_correo"
                        promptText="correo@empresa.com"
                        GridPane.rowIndex="5"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Estado:"
                        GridPane.rowIndex="6"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <ComboBox
                        fx:id="cmb_estado"
                        maxWidth="Infinity"
                        GridPane.rowIndex="6"
                        GridPane.columnIndex="1"/>

                    <Label
                        text="Rol:"
                        GridPane.rowIndex="7"
                        GridPane.columnIndex="0"
                        style="-fx-text-fill:#334155;-fx-font-weight:bold;"/>

                    <ComboBox
                        fx:id="cmb_rol"
                        maxWidth="Infinity"
                        GridPane.rowIndex="7"
                        GridPane.columnIndex="1"/>

                </GridPane>

            </VBox>

        </VBox>

        <HBox
            prefHeight="65"
            spacing="10"
            alignment="CENTER_RIGHT"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="10"
                    right="20"
                    bottom="10"
                    left="20"/>
            </padding>

            <Button
                fx:id="btn_cancelar"
                text="Cancelar"
                onAction="#acc_cancelar"
                prefWidth="105"
                prefHeight="38"
                style="-fx-background-color:#E2E8F0;-fx-text-fill:#334155;-fx-font-weight:bold;-fx-background-radius:4;"/>

            <Button
                fx:id="btn_grabar"
                text="Guardar"
                onAction="#acc_grabar"
                prefWidth="110"
                prefHeight="38"
                style="-fx-background-color:#0878D1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>

    </VBox>

</AnchorPane>