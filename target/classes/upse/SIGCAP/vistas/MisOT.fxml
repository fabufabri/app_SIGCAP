<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.MisOTController"
    prefWidth="1500"
    prefHeight="850"
    style="-fx-background-color:#E4E9EB;">

    <VBox
        spacing="12"
        AnchorPane.topAnchor="10"
        AnchorPane.bottomAnchor="10"
        AnchorPane.leftAnchor="20"
        AnchorPane.rightAnchor="20">

        <!-- CABECERA -->

        <HBox
            prefHeight="85"
            alignment="CENTER_LEFT"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="15"
                    right="20"
                    bottom="15"
                    left="20"/>
            </padding>

            <VBox
                spacing="4"
                HBox.hgrow="ALWAYS">

                <Label
                    text="MIS ÓRDENES DE TRABAJO"
                    style="-fx-text-fill:white;-fx-font-size:21px;-fx-font-weight:bold;"/>

                <Label
                    text="Órdenes de trabajo asignadas al usuario actual"
                    style="-fx-text-fill:#DDEAF6;-fx-font-size:12px;"/>

            </VBox>

            <VBox
                alignment="CENTER_RIGHT"
                spacing="4">

                <Label
                    text="USUARIO"
                    style="-fx-text-fill:#DDEAF6;-fx-font-size:10px;"/>

                <Label
                    fx:id="lbl_usuario"
                    text="-"
                    style="-fx-text-fill:white;-fx-font-size:14px;-fx-font-weight:bold;"/>

            </VBox>

        </HBox>


        <!-- RESUMEN -->

        <HBox spacing="10">

            <VBox
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                prefHeight="70"
                spacing="4"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="TOTAL"
                    style="-fx-text-fill:#52749B;-fx-font-size:11px;"/>

                <Label
                    fx:id="lbl_total"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:22px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                prefHeight="70"
                spacing="4"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="PENDIENTES"
                    style="-fx-text-fill:#52749B;-fx-font-size:11px;"/>

                <Label
                    fx:id="lbl_pendientes"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:22px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                prefHeight="70"
                spacing="4"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="ARTES"
                    style="-fx-text-fill:#52749B;-fx-font-size:11px;"/>

                <Label
                    fx:id="lbl_artes"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:22px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                prefHeight="70"
                spacing="4"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="PRODUCCIÓN"
                    style="-fx-text-fill:#52749B;-fx-font-size:11px;"/>

                <Label
                    fx:id="lbl_produccion"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:22px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                prefHeight="70"
                spacing="4"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="COMPLETADAS"
                    style="-fx-text-fill:#52749B;-fx-font-size:11px;"/>

                <Label
                    fx:id="lbl_completadas"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:22px;-fx-font-weight:bold;"/>

            </VBox>

        </HBox>


        <!-- BÚSQUEDA -->

        <HBox
            alignment="CENTER_LEFT"
            spacing="10"
            style="-fx-background-color:white;-fx-background-radius:6;">

            <padding>
                <Insets
                    top="14"
                    right="16"
                    bottom="14"
                    left="16"/>
            </padding>

            <VBox
                spacing="3"
                HBox.hgrow="ALWAYS">

                <Label
                    text="MIS OT"
                    style="-fx-text-fill:#20487A;-fx-font-size:15px;-fx-font-weight:bold;"/>

                <Label
                    text="Busca dentro de las órdenes asignadas a ti."
                    style="-fx-text-fill:#64748B;-fx-font-size:11px;"/>

            </VBox>

            <TextField
                fx:id="txt_buscar"
                promptText="Buscar OT, cliente, campaña, ciudad o estado..."
                prefWidth="450"
                prefHeight="36"/>

            <Button
                text="Actualizar"
                onAction="#acc_actualizar"
                prefWidth="105"
                prefHeight="36"
                style="-fx-background-color:#20487A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

            <Button
                text="Limpiar"
                onAction="#acc_limpiar"
                prefWidth="90"
                prefHeight="36"
                style="-fx-background-color:#E4E9EB;-fx-text-fill:#20487A;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>


        <!-- TABLA -->

        <VBox
            spacing="8"
            VBox.vgrow="ALWAYS"
            style="-fx-background-color:white;-fx-background-radius:6;">

            <padding>
                <Insets
                    top="15"
                    right="15"
                    bottom="15"
                    left="15"/>
            </padding>

            <Label
                text="ÓRDENES ASIGNADAS"
                style="-fx-text-fill:#20487A;-fx-font-size:16px;-fx-font-weight:bold;"/>

            <Label
                text="Doble clic sobre una OT para abrir el detalle."
                style="-fx-text-fill:#64748B;-fx-font-size:11px;"/>

            <TableView
                fx:id="tb_ordenes"
                VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                        fx:id="col_codigo"
                        text="OT"
                        prefWidth="125"/>

                    <TableColumn
                        fx:id="col_cliente"
                        text="Cliente"
                        prefWidth="180"/>

                    <TableColumn
                        fx:id="col_campania"
                        text="Campaña"
                        prefWidth="190"/>

                    <TableColumn
                        fx:id="col_ciudad"
                        text="Ciudad"
                        prefWidth="110"/>

                    <TableColumn
                        fx:id="col_fecha"
                        text="Fecha"
                        prefWidth="110"/>

                    <TableColumn
                        fx:id="col_fecha_requerida"
                        text="Fecha requerida"
                        prefWidth="125"/>

                    <TableColumn
                        fx:id="col_prioridad"
                        text="Prioridad"
                        prefWidth="100"/>

                    <TableColumn
                        fx:id="col_estado"
                        text="Estado"
                        prefWidth="150"/>

                </columns>

                <placeholder>

                    <Label
                        text="No tienes Órdenes de Trabajo asignadas."
                        style="-fx-text-fill:#64748B;-fx-font-size:13px;"/>

                </placeholder>

            </TableView>

        </VBox>


        <!-- PIE -->

        <HBox
            alignment="CENTER_RIGHT">

            <Button
                text="Volver"
                onAction="#acc_volver"
                prefWidth="100"
                prefHeight="38"
                style="-fx-background-color:#082F52;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>

    </VBox>

</AnchorPane>