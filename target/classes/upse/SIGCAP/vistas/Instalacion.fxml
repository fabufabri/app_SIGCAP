<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="upse.SIGCAP.controlador.InstalacionController"
            prefWidth="850.0"
            prefHeight="560.0"
            style="-fx-background-color: #E4E9EB;">

    <children>

        <Pane layoutX="0.0"
              layoutY="0.0"
              prefWidth="850.0"
              prefHeight="80.0"
              style="-fx-background-color: #20487A;">

            <children>

                <Label layoutX="25.0"
                       layoutY="18.0"
                       text="INSTALACIÓN"
                       textFill="WHITE"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-font-style: italic;"/>

                <Label layoutX="27.0"
                       layoutY="52.0"
                       text="Registro y gestión de instalación"
                       textFill="WHITE"
                       style="-fx-font-size: 14px;"/>

            </children>

        </Pane>

        <VBox layoutX="25.0"
              layoutY="105.0"
              prefWidth="800.0"
              spacing="18.0">

            <children>

                <HBox spacing="15.0">

                    <children>

                        <VBox prefWidth="250.0"
                              spacing="6.0">

                            <children>

                                <Label text="Ítem Orden de Trabajo"
                                       style="-fx-font-weight: bold;"/>

                                <TextField fx:id="txt_item"
                                           prefWidth="250.0"
                                           prefHeight="32.0"
                                           promptText="ID del ítem"/>

                            </children>

                        </VBox>

                        <VBox prefWidth="250.0"
                              spacing="6.0">

                            <children>

                                <Label text="Tercero"
                                       style="-fx-font-weight: bold;"/>

                                <TextField fx:id="txt_tercero"
                                           prefWidth="250.0"
                                           prefHeight="32.0"
                                           promptText="ID del tercero"/>

                            </children>

                        </VBox>

                        <VBox prefWidth="250.0"
                              spacing="6.0">

                            <children>

                                <Label text="Tipo de Instalación"
                                       style="-fx-font-weight: bold;"/>

                                <TextField fx:id="txt_tipo"
                                           prefWidth="250.0"
                                           prefHeight="32.0"
                                           promptText="ID del tipo"/>

                            </children>

                        </VBox>

                    </children>

                </HBox>

                <HBox spacing="15.0">

                    <children>

                        <VBox prefWidth="250.0"
                              spacing="6.0">

                            <children>

                                <Label text="Fecha programada"
                                       style="-fx-font-weight: bold;"/>

                                <DatePicker fx:id="dtp_fecha_programada"
                                            prefWidth="250.0"
                                            prefHeight="32.0"/>

                            </children>

                        </VBox>

                        <VBox prefWidth="250.0"
                              spacing="6.0">

                            <children>

                                <Label text="Fecha real"
                                       style="-fx-font-weight: bold;"/>

                                <DatePicker fx:id="dtp_fecha_real"
                                            prefWidth="250.0"
                                            prefHeight="32.0"/>

                            </children>

                        </VBox>

                        <VBox prefWidth="250.0"
                              spacing="6.0">

                            <children>

                                <Label text="Estado"
                                       style="-fx-font-weight: bold;"/>

                                <ComboBox fx:id="cmb_estado"
                                          prefWidth="250.0"
                                          prefHeight="32.0"/>

                            </children>

                        </VBox>

                    </children>

                </HBox>

                <VBox spacing="6.0">

                    <children>

                        <Label text="Evidencia"
                               style="-fx-font-weight: bold;"/>

                        <TextField fx:id="txt_evidencia"
                                   prefWidth="800.0"
                                   prefHeight="32.0"
                                   promptText="Ruta o referencia de evidencia"/>

                    </children>

                </VBox>

                <VBox spacing="6.0">

                    <children>

                        <Label text="Observaciones"
                               style="-fx-font-weight: bold;"/>

                        <TextArea fx:id="txt_observaciones"
                                  prefWidth="800.0"
                                  prefHeight="110.0"
                                  wrapText="true"
                                  promptText="Ingrese observaciones"/>

                    </children>

                </VBox>

            </children>

        </VBox>

        <Pane layoutX="0.0"
              layoutY="480.0"
              prefWidth="850.0"
              prefHeight="80.0"
              style="-fx-background-color: #20487A;">

            <children>

                <Button fx:id="btn_grabar"
                        layoutX="590.0"
                        layoutY="20.0"
                        prefWidth="105.0"
                        prefHeight="40.0"
                        text="Grabar"
                        onAction="#acc_grabar"/>

                <Button fx:id="btn_cancelar"
                        layoutX="710.0"
                        layoutY="20.0"
                        prefWidth="105.0"
                        prefHeight="40.0"
                        text="Cancelar"
                        onAction="#acc_cancelar"/>

            </children>

        </Pane>

    </children>

</AnchorPane>