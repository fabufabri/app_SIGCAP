<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.UsuariosController"
    prefWidth="1100"
    prefHeight="650"
    style="-fx-background-color:#F4F7FA;">

    <VBox
        AnchorPane.topAnchor="0"
        AnchorPane.bottomAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0"
        spacing="0">

        <VBox
            prefHeight="85"
            spacing="5"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="15"
                    right="25"
                    bottom="15"
                    left="25"/>
            </padding>

            <Label
                text="USUARIOS"
                style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>

            <Label
                text="Administración de usuarios del sistema"
                style="-fx-text-fill:#DDEAF6;-fx-font-size:12px;"/>

        </VBox>

        <VBox
            VBox.vgrow="ALWAYS"
            spacing="12">

            <padding>
                <Insets
                    top="18"
                    right="20"
                    bottom="18"
                    left="20"/>
            </padding>

            <HBox
                spacing="10"
                alignment="CENTER_LEFT">

                <Label
                    text="Buscar:"
                    style="-fx-text-fill:#20487A;-fx-font-weight:bold;"/>

                <TextField
                    fx:id="txt_buscar"
                    prefWidth="300"
                    promptText="Usuario, nombres o apellidos..."
                    HBox.hgrow="ALWAYS"/>

                <Button
                    fx:id="btn_nuevo"
                    text="Nuevo"
                    onAction="#acc_nuevo"
                    prefWidth="100"
                    prefHeight="36"
                    style="-fx-background-color:#0878D1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

                <Button
                    fx:id="btn_editar"
                    text="Editar"
                    onAction="#acc_editar"
                    prefWidth="100"
                    prefHeight="36"
                    style="-fx-background-color:#20487A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

            </HBox>

            <TableView
                fx:id="tb_usuarios"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:white;">

                <columns>

                    <TableColumn
                        fx:id="col_id"
                        text="ID"
                        prefWidth="70"/>

                    <TableColumn
                        fx:id="col_usuario"
                        text="USUARIO"
                        prefWidth="160"/>

                    <TableColumn
                        fx:id="col_nombres"
                        text="NOMBRES"
                        prefWidth="200"/>

                    <TableColumn
                        fx:id="col_apellidos"
                        text="APELLIDOS"
                        prefWidth="200"/>

                    <TableColumn
                        fx:id="col_estado"
                        text="ESTADO"
                        prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>

        <HBox
            prefHeight="65"
            spacing="10"
            alignment="CENTER_RIGHT"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="10"
                    right="20"
                    bottom="10"
                    left="20"/>
            </padding>

            <Button
                fx:id="btn_cerrar"
                text="Cerrar"
                onAction="#acc_cerrar"
                prefWidth="110"
                prefHeight="38"
                style="-fx-background-color:white;-fx-text-fill:#20487A;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>

    </VBox>

</AnchorPane>