<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.TerceroController"
    prefWidth="600"
    prefHeight="410"
    style="-fx-background-color:#E4E9EB;">

    <VBox
        spacing="0"
        AnchorPane.topAnchor="0"
        AnchorPane.bottomAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0">

        <VBox
            spacing="3"
            prefHeight="78"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Label
                text="TERCERO"
                style="-fx-text-fill:white;-fx-font-size:21px;-fx-font-weight:bold;"/>

            <Label
                text="Información del tercero"
                style="-fx-text-fill:#DDEAF6;-fx-font-size:12px;"/>

        </VBox>

        <VBox
            spacing="13"
            VBox.vgrow="ALWAYS">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <Label
                text="DATOS DEL TERCERO"
                style="-fx-text-fill:#20487A;-fx-font-size:15px;-fx-font-weight:bold;"/>

            <VBox spacing="4">

                <Label
                    text="NOMBRE / RAZÓN SOCIAL"
                    style="-fx-text-fill:#20487A;-fx-font-size:11px;-fx-font-weight:bold;"/>

                <TextField
                    fx:id="txt_nombre"
                    promptText="Ingrese el nombre o razón social"
                    prefHeight="36"/>

            </VBox>

            <HBox spacing="12">

                <VBox
                    spacing="4"
                    HBox.hgrow="ALWAYS">

                    <Label
                        text="TELÉFONO"
                        style="-fx-text-fill:#20487A;-fx-font-size:11px;-fx-font-weight:bold;"/>

                    <TextField
                        fx:id="txt_telefono"
                        promptText="Teléfono"
                        prefHeight="36"/>

                </VBox>

                <VBox
                    spacing="4"
                    HBox.hgrow="ALWAYS">

                    <Label
                        text="CORREO"
                        style="-fx-text-fill:#20487A;-fx-font-size:11px;-fx-font-weight:bold;"/>

                    <TextField
                        fx:id="txt_correo"
                        promptText="Correo electrónico"
                        prefHeight="36"/>

                </VBox>

            </HBox>

            <VBox spacing="4">

                <Label
                    text="ESTADO"
                    style="-fx-text-fill:#20487A;-fx-font-size:11px;-fx-font-weight:bold;"/>

                <ComboBox
                    fx:id="cmb_estado"
                    prefWidth="120"
                    prefHeight="36"/>

            </VBox>

        </VBox>

        <HBox
            spacing="10"
            alignment="CENTER_RIGHT"
            prefHeight="65"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button
                fx:id="btn_cancelar"
                text="Cancelar"
                onAction="#acc_cancelar"
                prefWidth="100"
                prefHeight="38"
                style="-fx-background-color:#64748B;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

            <Button
                fx:id="btn_grabar"
                text="Guardar"
                onAction="#acc_grabar"
                prefWidth="110"
                prefHeight="38"
                style="-fx-background-color:#087ED1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>

    </VBox>

</AnchorPane>