<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<AnchorPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="upse.SIGCAP.controlador.ConsultaFacturaController"
            prefWidth="1000.0"
            prefHeight="600.0"
            style="-fx-background-color: #E4E9EB;">

    <children>

        <Pane prefHeight="70.0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              style="-fx-background-color: #20487A;">

            <children>

                <Label text="CONSULTA DE FACTURAS"
                       layoutX="25.0"
                       layoutY="20.0"
                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-font-style: italic;"/>

            </children>

        </Pane>

        <HBox layoutX="25.0"
              layoutY="90.0"
              spacing="10.0">

            <children>

                <Label text="N° Factura:"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="txt_numFactura"
                           prefWidth="250.0"
                           promptText="Buscar por número"/>

                <Button fx:id="btn_buscar"
                        text="Buscar"
                        onAction="#acc_buscar"
                        prefWidth="100.0"/>

            </children>

        </HBox>

        <TableView fx:id="tb_facturas"
                   layoutX="25.0"
                   layoutY="135.0"
                   prefWidth="950.0"
                   prefHeight="350.0"
                   AnchorPane.leftAnchor="25.0"
                   AnchorPane.rightAnchor="25.0">

            <columns>

                <TableColumn fx:id="col_numero"
                             text="N° Factura"
                             prefWidth="150.0"/>

                <TableColumn fx:id="col_fecha"
                             text="Fecha"
                             prefWidth="120.0"/>

                <TableColumn fx:id="col_cliente"
                             text="Cliente"
                             prefWidth="250.0"/>

                <TableColumn fx:id="col_total"
                             text="Total"
                             prefWidth="120.0"/>

                <TableColumn fx:id="col_estado"
                             text="Estado"
                             prefWidth="120.0"/>

                <TableColumn fx:id="col_estadoSri"
                             text="Estado SRI"
                             prefWidth="150.0"/>

            </columns>

        </TableView>

        <Pane prefHeight="80.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              style="-fx-background-color: #20487A;">

            <children>

                <Button fx:id="btn_abrir"
                        text="Abrir"
                        onAction="#acc_abrir"
                        layoutX="25.0"
                        layoutY="20.0"
                        prefWidth="110.0"/>

                <Button fx:id="btn_enviarSri"
                        text="Enviar SRI"
                        onAction="#acc_enviarSri"
                        layoutX="150.0"
                        layoutY="20.0"
                        prefWidth="110.0"/>

                <Button fx:id="btn_cerrar"
                        text="Cerrar"
                        onAction="#acc_cerrar"
                        layoutX="850.0"
                        layoutY="20.0"
                        prefWidth="110.0"/>

            </children>

        </Pane>

    </children>

</AnchorPane>