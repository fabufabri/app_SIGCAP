<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.CiudadController"
    prefWidth="520"
    prefHeight="330"
    style="-fx-background-color:#F5F7FA;">

    <VBox
        AnchorPane.topAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0"
        AnchorPane.bottomAnchor="0"
        spacing="20">

        <VBox
            spacing="4"
            style="-fx-background-color:#062B4D;">

            <padding>
                <Insets
                    top="20"
                    right="25"
                    bottom="20"
                    left="25"/>
            </padding>

            <Label
                text="Ciudad"
                style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:white;"/>

            <Label
                text="Información de la ciudad"
                style="-fx-font-size:13px;-fx-text-fill:#C9D8E6;"/>

        </VBox>

        <VBox
            spacing="10">

            <padding>
                <Insets
                    top="0"
                    right="30"
                    bottom="0"
                    left="30"/>
            </padding>

            <Label
                text="Nombre de la ciudad *"
                style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>

            <TextField
                fx:id="txt_nombre"
                promptText="Ejemplo: Quito"
                prefHeight="38"
                style="-fx-background-color:white;-fx-border-color:#CBD5E1;-fx-border-radius:5;-fx-background-radius:5;"/>

            <Label
                text="Estado"
                style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#334155;"/>

            <ComboBox
                fx:id="cmb_estado"
                maxWidth="Infinity"
                prefHeight="38"/>

        </VBox>

        <HBox
            spacing="10"
            alignment="CENTER_RIGHT"
            VBox.vgrow="ALWAYS">

            <padding>
                <Insets
                    top="10"
                    right="30"
                    bottom="25"
                    left="30"/>
            </padding>

            <Button
                fx:id="btn_cancelar"
                text="Cancelar"
                onAction="#acc_cancelar"
                prefWidth="110"
                prefHeight="38"
                style="-fx-background-color:#E2E8F0;-fx-text-fill:#334155;-fx-font-weight:bold;-fx-background-radius:5;"/>

            <Button
                fx:id="btn_grabar"
                text="Guardar"
                onAction="#acc_grabar"
                prefWidth="110"
                prefHeight="38"
                style="-fx-background-color:#0878D1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:5;"/>

        </HBox>

    </VBox>

</AnchorPane>