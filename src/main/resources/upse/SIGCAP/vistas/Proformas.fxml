<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.ProformasController"
    prefWidth="1100"
    prefHeight="650"
    style="-fx-background-color:#E4E9EB;">

    <top>

        <VBox
            spacing="5"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="18"
                    right="25"
                    bottom="18"
                    left="25"/>
            </padding>

            <Label
                text="PROFORMAS"
                style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;-fx-font-style:italic;"/>

            <Label
                text="Gestión de cotizaciones comerciales"
                style="-fx-text-fill:white;-fx-font-size:12px;"/>

        </VBox>

    </top>

    <center>

        <VBox
            spacing="12"
            style="-fx-background-color:#E4E9EB;">

            <padding>
                <Insets
                    top="20"
                    right="25"
                    bottom="20"
                    left="25"/>
            </padding>

            <HBox
                spacing="10"
                alignment="CENTER_LEFT"
                style="-fx-background-color:white;-fx-background-radius:6;-fx-padding:12;">

                <Label
                    text="Buscar:"
                    style="-fx-font-weight:bold;-fx-text-fill:#20487A;"/>

                <TextField
                    fx:id="txt_buscar"
                    prefWidth="350"
                    promptText="Código, cliente, campaña o estado"/>

                <Button
                    fx:id="btn_nuevo"
                    text="Nuevo"
                    onAction="#acc_nuevo"
                    prefWidth="100"
                    style="-fx-background-color:#0878D1;-fx-text-fill:white;-fx-font-weight:bold;"/>

            </HBox>

            <TableView
                fx:id="tb_proformas"
                VBox.vgrow="ALWAYS"
                onMouseClicked="#acc_dobleClick">

                <columns>

                    <TableColumn
                        fx:id="col_id"
                        text="ID"
                        prefWidth="60"/>

                    <TableColumn
                        fx:id="col_codigo"
                        text="Código"
                        prefWidth="120"/>

                    <TableColumn
                        fx:id="col_cliente"
                        text="Cliente"
                        prefWidth="200"/>

                    <TableColumn
                        fx:id="col_campania"
                        text="Campaña"
                        prefWidth="200"/>

                    <TableColumn
                        fx:id="col_fecha"
                        text="Fecha"
                        prefWidth="120"/>

                    <TableColumn
                        fx:id="col_total"
                        text="Total"
                        prefWidth="120"/>

                    <TableColumn
                        fx:id="col_estado"
                        text="Estado"
                        prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </center>

    <bottom>

        <HBox
            alignment="CENTER_RIGHT"
            spacing="10"
            style="-fx-background-color:#20487A;">

            <padding>
                <Insets
                    top="10"
                    right="20"
                    bottom="10"
                    left="20"/>
            </padding>

            <Button
                fx:id="btn_cerrar"
                text="Cerrar"
                onAction="#acc_cerrar"
                prefWidth="100"
                style="-fx-background-color:white;-fx-text-fill:#20487A;-fx-font-weight:bold;"/>

        </HBox>

    </bottom>

</BorderPane>