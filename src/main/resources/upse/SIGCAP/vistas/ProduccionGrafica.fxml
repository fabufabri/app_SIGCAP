<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="upse.SIGCAP.controlador.ProduccionGraficaController"
    prefWidth="1500"
    prefHeight="850"
    style="-fx-background-color:#E4E9EB;">

    <VBox
        spacing="12"
        AnchorPane.topAnchor="0"
        AnchorPane.bottomAnchor="0"
        AnchorPane.leftAnchor="0"
        AnchorPane.rightAnchor="0">

        <padding>
            <Insets top="18" right="22" bottom="18" left="22"/>
        </padding>

        <HBox
            prefHeight="75"
            alignment="CENTER_LEFT"
            style="-fx-background-color:#20487A;-fx-background-radius:5;">

            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>

            <VBox spacing="3" HBox.hgrow="ALWAYS">

                <Label
                    text="PRODUCCIÓN GRÁFICA"
                    style="-fx-text-fill:white;-fx-font-size:22px;-fx-font-weight:bold;"/>

                <Label
                    text="Gestión y seguimiento de las Órdenes de Trabajo"
                    style="-fx-text-fill:#DDEAF6;-fx-font-size:12px;"/>

            </VBox>

            <Label
                text="SIGCAP"
                style="-fx-text-fill:white;-fx-font-size:14px;-fx-font-weight:bold;"/>

        </HBox>

        <HBox spacing="10" prefHeight="82">

            <VBox
                spacing="3"
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="TOTAL OT"
                    style="-fx-text-fill:#64748B;-fx-font-size:10px;-fx-font-weight:bold;"/>

                <Label
                    fx:id="lbl_total"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:24px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                spacing="3"
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="EN ARTES"
                    style="-fx-text-fill:#64748B;-fx-font-size:10px;-fx-font-weight:bold;"/>

                <Label
                    fx:id="lbl_artes"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:24px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                spacing="3"
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="EN PRODUCCIÓN"
                    style="-fx-text-fill:#64748B;-fx-font-size:10px;-fx-font-weight:bold;"/>

                <Label
                    fx:id="lbl_produccion"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:24px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                spacing="3"
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="EN INSTALACIÓN"
                    style="-fx-text-fill:#64748B;-fx-font-size:10px;-fx-font-weight:bold;"/>

                <Label
                    fx:id="lbl_instalacion"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:24px;-fx-font-weight:bold;"/>

            </VBox>

            <VBox
                spacing="3"
                alignment="CENTER"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <Label
                    text="COMPLETADAS"
                    style="-fx-text-fill:#64748B;-fx-font-size:10px;-fx-font-weight:bold;"/>

                <Label
                    fx:id="lbl_completados"
                    text="0"
                    style="-fx-text-fill:#20487A;-fx-font-size:24px;-fx-font-weight:bold;"/>

            </VBox>

        </HBox>

        <HBox spacing="12" VBox.vgrow="ALWAYS">

            <VBox
                spacing="8"
                prefWidth="700"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">

                    <VBox spacing="3" HBox.hgrow="ALWAYS">

                        <Label
                            text="ÓRDENES DE TRABAJO"
                            style="-fx-text-fill:#20487A;-fx-font-size:16px;-fx-font-weight:bold;"/>

                        <Label
                            text="Seleccione una OT para visualizar sus elementos."
                            style="-fx-text-fill:#64748B;-fx-font-size:11px;"/>

                    </VBox>

                    <TextField
                        fx:id="txt_buscar"
                        promptText="Buscar OT..."
                        prefWidth="210"
                        prefHeight="34"/>

                </HBox>

                <TableView
                    fx:id="tb_ordenes"
                    VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                            fx:id="col_codigo"
                            text="OT"
                            prefWidth="85"/>

                        <TableColumn
                            fx:id="col_cliente"
                            text="Cliente"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="col_campania"
                            text="Campaña"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="col_ciudad"
                            text="Ciudad"
                            prefWidth="80"/>

                        <TableColumn
                            fx:id="col_fecha_requerida"
                            text="Fecha requerida"
                            prefWidth="105"/>

                        <TableColumn
                            fx:id="col_prioridad"
                            text="Prioridad"
                            prefWidth="80"/>

                        <TableColumn
                            fx:id="col_responsable"
                            text="Responsable"
                            prefWidth="110"/>

                        <TableColumn
                            fx:id="col_estado"
                            text="Estado"
                            prefWidth="110"/>

                    </columns>

                    <placeholder>
                        <Label
                            text="No existen Órdenes de Trabajo."
                            style="-fx-text-fill:#64748B;"/>
                    </placeholder>

                </TableView>

            </VBox>

            <VBox
                spacing="8"
                prefWidth="760"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color:white;-fx-background-radius:6;">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <VBox
                    spacing="8"
                    style="-fx-background-color:#F5F7F9;-fx-background-radius:5;">

                    <padding>
                        <Insets top="12" right="12" bottom="12" left="12"/>
                    </padding>

                    <Label
                        text="ORDEN SELECCIONADA"
                        style="-fx-text-fill:#20487A;-fx-font-size:13px;-fx-font-weight:bold;"/>

                    <HBox spacing="25">

                        <VBox spacing="2">

                            <Label
                                text="OT"
                                style="-fx-text-fill:#64748B;-fx-font-size:10px;"/>

                            <Label
                                fx:id="lbl_ot"
                                text="-"
                                style="-fx-text-fill:#20487A;-fx-font-size:14px;-fx-font-weight:bold;"/>

                        </VBox>

                        <VBox
                            spacing="2"
                            HBox.hgrow="ALWAYS">

                            <Label
                                text="CLIENTE"
                                style="-fx-text-fill:#64748B;-fx-font-size:10px;"/>

                            <Label
                                fx:id="lbl_cliente"
                                text="-"
                                style="-fx-text-fill:#20487A;-fx-font-size:13px;-fx-font-weight:bold;"/>

                        </VBox>

                        <VBox
                            spacing="2"
                            HBox.hgrow="ALWAYS">

                            <Label
                                text="CAMPAÑA"
                                style="-fx-text-fill:#64748B;-fx-font-size:10px;"/>

                            <Label
                                fx:id="lbl_campania"
                                text="-"
                                style="-fx-text-fill:#20487A;-fx-font-size:13px;-fx-font-weight:bold;"/>

                        </VBox>

                    </HBox>

                    <HBox spacing="25">

                        <VBox spacing="2">

                            <Label
                                text="FECHA REQUERIDA"
                                style="-fx-text-fill:#64748B;-fx-font-size:10px;"/>

                            <Label
                                fx:id="lbl_fecha_requerida"
                                text="-"
                                style="-fx-text-fill:#20487A;-fx-font-size:12px;"/>

                        </VBox>

                        <VBox spacing="2">

                            <Label
                                text="ESTADO"
                                style="-fx-text-fill:#64748B;-fx-font-size:10px;"/>

                            <Label
                                fx:id="lbl_estado"
                                text="-"
                                style="-fx-text-fill:#20487A;-fx-font-size:12px;-fx-font-weight:bold;"/>

                        </VBox>

                    </HBox>

                </VBox>

                <HBox alignment="CENTER_LEFT">

                    <VBox
                        spacing="2"
                        HBox.hgrow="ALWAYS">

                        <Label
                            text="ELEMENTOS DE PRODUCCIÓN"
                            style="-fx-text-fill:#20487A;-fx-font-size:15px;-fx-font-weight:bold;"/>

                        <Label
                            text="Productos y materiales asociados a la OT."
                            style="-fx-text-fill:#64748B;-fx-font-size:11px;"/>

                    </VBox>

                    <Label
                        text="Items:"
                        style="-fx-text-fill:#64748B;-fx-font-size:11px;"/>

                    <Label
                        fx:id="lbl_items"
                        text="0"
                        style="-fx-text-fill:#20487A;-fx-font-size:15px;-fx-font-weight:bold;"/>

                </HBox>

                <TableView
                    fx:id="tb_items"
                    VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn
                            fx:id="col_item"
                            text="N°"
                            prefWidth="45"/>

                        <TableColumn
                            fx:id="col_local"
                            text="Local"
                            prefWidth="75"/>

                        <TableColumn
                            fx:id="col_producto"
                            text="Producto"
                            prefWidth="100"/>

                        <TableColumn
                            fx:id="col_descripcion"
                            text="Descripción"
                            prefWidth="130"/>

                        <TableColumn
                            fx:id="col_medida"
                            text="Medida"
                            prefWidth="75"/>

                        <TableColumn
                            fx:id="col_material"
                            text="Material"
                            prefWidth="90"/>

                        <TableColumn
                            fx:id="col_cantidad"
                            text="Cantidad"
                            prefWidth="65"/>

                        <TableColumn
                            fx:id="col_instalacion"
                            text="Instalación"
                            prefWidth="85"/>

                        <TableColumn
                            fx:id="col_item_estado"
                            text="Estado"
                            prefWidth="100"/>

                        <TableColumn
                            fx:id="col_progreso"
                            text="Progreso"
                            prefWidth="70"/>

                    </columns>

                    <placeholder>

                        <Label
                            text="Seleccione una Orden de Trabajo."
                            style="-fx-text-fill:#64748B;"/>

                    </placeholder>

                </TableView>

            </VBox>

        </HBox>

        <HBox
            alignment="CENTER_RIGHT"
            spacing="8">

            <Button
                text="Actualizar"
                onAction="#acc_actualizar"
                prefWidth="105"
                prefHeight="38"
                style="-fx-background-color:#20487A;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

            <Button
                text="Abrir OT"
                onAction="#acc_abrirOT"
                prefWidth="100"
                prefHeight="38"
                style="-fx-background-color:#087ED1;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

            <Button
                text="Volver"
                onAction="#acc_volver"
                prefWidth="100"
                prefHeight="38"
                style="-fx-background-color:#082F52;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:4;"/>

        </HBox>

    </VBox>

</AnchorPane>